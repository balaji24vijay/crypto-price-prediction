# Copy this file to .env or set these values in your deployment environment.
FLASK_SECRET_KEY=replace-with-a-long-random-value
CRYPTOCOMPARE_API_KEY=
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
PORT=5000
COOKIE_SECURE=0
PREDICTION_HORIZON=12
REQUEST_TIMEOUT=15
# Optional: keep the database outside the source tree in production.
# DATABASE_PATH=C:/data/cryptovault/signup.db
